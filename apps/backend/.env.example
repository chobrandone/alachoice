# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed front-end origins (CORS whitelist)
CORS_ORIGINS=http://localhost:5173
# Public front-end base URL — used to build sitemap.xml <loc> entries
SITE_URL=http://localhost:5173

# ---- Supabase ----
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# anon key: safe for public reads under RLS
SUPABASE_ANON_KEY=your-anon-key
# service role key: SERVER-SIDE ONLY. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Email (Nodemailer SMTP) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ALA Website <no-reply@alachoice.com>"
# Where inquiry / quote notifications are delivered
MAIL_NOTIFY_TO=contacts@alachoice.com

# ---- Rate limiting ----
PUBLIC_RATE_WINDOW_MS=900000
PUBLIC_RATE_MAX=30
