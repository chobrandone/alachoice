# Base URL of the ALA Express API (include /api/v1)
# Local dev:
VITE_API_URL=http://localhost:4000/api/v1
# All-on-Vercel (single project, API served same-origin): use a relative path
# VITE_API_URL=/api/v1
# Separate API host (Railway/Render): full URL, e.g. https://your-api.up.railway.app/api/v1
